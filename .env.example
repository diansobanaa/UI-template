# Python API is the preferred control/data plane.
VITE_PYTHON_API_BASE=http://localhost:8000/api/v1

# Optional direct ESP32 REST fallback. Use a reachable local/VPN address.
VITE_ESP32_API_BASE=http://192.168.1.50
VITE_ENABLE_DIRECT_ESP32=false

# Transport safety defaults.
VITE_API_TIMEOUT_MS=8000
# Do not commit production tokens. Prefer a short-lived session token.
VITE_API_TOKEN=
