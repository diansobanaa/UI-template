# Target Configuration
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# CPU and Memory
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# HEAP-FIX: Was 2048 — forced ALL allocs ≤2KB (including cJSON nodes ~36 bytes each,
# hundreds per HTTP request) into internal RAM → fragmentation → heap exhaustion
# (7KB free after boot → HTTP server can't create task → ESP_ERR_HTTPD_TASK).
# Set to 0: ALL regular malloc/calloc goes to PSRAM by default.
# DMA-sensitive code already uses heap_caps_malloc(MALLOC_CAP_DMA) which forces internal.
# WiFi/LWIP handled by CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y above.
# This saves ~30-50KB internal RAM, enough for HTTP server task creation.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Flash Size and Partition Table
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS Configuration
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# DIAG-05 (2026-09-28, TEMPORARY): method-2 canary, checked on every context
# switch; overflow aborts and names the task. See note above.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# ESP HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y
CONFIG_HTTPD_PURGE_BUF_LEN=32
CONFIG_HTTPD_WS_SUPPORT=y
# HEAP-FIX: Reduce HTTP server task stack from default 8192 to 4096.
# Our HTTP handlers are lightweight (cJSON ops go to PSRAM now).
# This saves 4KB internal RAM for HTTP server task creation.
CONFIG_HTTPD_DEFAULT_TASK_STACK_SIZE=4096

# mDNS
CONFIG_MDNS_MAX_SERVICES=10
# HEAP-FIX: Reduce mDNS task stack from 4096 to 3072.
CONFIG_MDNS_TASK_STACK_SIZE=3072

# LWIP & Networking
# HEAP-FIX: Reduce sockets from 16 to 8 — we don't need 16 concurrent sockets.
# Each socket uses ~1.5KB internal RAM for buffers.
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# VFS and Storage
CONFIG_SPIFFS_MAX_PARTITIONS=2
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# System and Task Stacks
# HEAP-FIX: Reduce main task stack from 16384 to 8192.
# Main task only runs app_main() (init sequence) then exits — doesn't need 16KB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# HEAP-FIX: Reduce event task stack from 6144 to 4096.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_IPC_USES_CALLERS_PRIORITY=n
# DIAG-05 (2026-09-28, TEMPORARY): comprehensive heap poisoning + FreeRTOS
# stack canary to NAME the Core-1 scheduler corrupter (LoadProhibited in
# prvSelectHighestPriorityTaskSMP ~6.7s after boot). Revert to
# CONFIG_HEAP_POISONING_DISABLED=y and drop the canary line once the culprit
# task is identified and fixed. Costs CPU + heap overhead; debug only.
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

